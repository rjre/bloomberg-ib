# Copy to .env and fill in with values from your console.bloomberg.com application.
# Never commit the real .env file.

IB_CONNECT_CLIENT_ID=
IB_CONNECT_CLIENT_SECRET=
IB_CONNECT_BASE_URL=https://api.bloomberg.com
# Unconfirmed for IB Connect specifically - see ib_connect/auth.py. Leave
# unset unless your Bloomberg representative tells you a region is required.
IB_CONNECT_REGION=

# Optional, used by the example scripts:
IB_CONNECT_STREAM_ID=
IB_CONNECT_CHATBOT_UUID=
